        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\ntitle Library Management System - ER Diagram\n\nskinparam shadowing false\nskinparam linetype ortho\n\nentity \&quot;Books\&quot; as Books {\n    * BookId : INTEGER &lt;&lt;PK&gt;&gt;\n    --\n    BookTitle : TEXT\n    Author : TEXT\n    Category : TEXT\n    Quatity : INTEGER\n    AccessLevel : TEXT\n    AvailableCopies : INTEGER\n    Price : REAL\n}\n\nentity \&quot;Members\&quot; as Members {\n    * MemberId : INTEGER &lt;&lt;PK&gt;&gt;\n    --\n    MemberName : TEXT\n    Email : TEXT\n    Phone : TEXT\n    MemberType : TEXT\n}\n\nentity \&quot;Borrowing\&quot; as Borrowing {\n    * BorrowId : INTEGER &lt;&lt;PK&gt;&gt;\n    --\n    MemberId : INTEGER &lt;&lt;FK&gt;&gt;\n    BookId : INTEGER &lt;&lt;FK&gt;&gt;\n    IssueDate : DATE\n    DueDate : DATE\n    ReturnDate : DATE\n    Status : TEXT\n}\n\nentity \&quot;Fines\&quot; as Fines {\n    * FineId : INTEGER &lt;&lt;PK&gt;&gt;\n    --\n    BorrowId : INTEGER &lt;&lt;FK&gt;&gt;\n    Amount : REAL\n    PaidStatus : TEXT\n}\n\nentity \&quot;Acquisitions\&quot; as Acquisitions {\n    * AcquisitionId : INTEGER &lt;&lt;PK&gt;&gt;\n    --\n    BookId : INTEGER &lt;&lt;FK&gt;&gt;\n    Quantity : INTEGER\n    Supplier : TEXT\n    PurchasePrice : REAL\n    PurchaseDate : DATE\n}\n\nentity \&quot;BookPriceHistory\&quot; as PriceHistory {\n    * HistoryId : INTEGER &lt;&lt;PK&gt;&gt;\n    --\n    BookId : INTEGER &lt;&lt;FK&gt;&gt;\n    Oldprice : REAL\n    Newprice : REAL\n    Updatedate : DATE\n}\n\nentity \&quot;AuditLog\&quot; as AuditLog {\n    * AuditId : INTEGER &lt;&lt;PK&gt;&gt;\n    --\n    Action : TEXT\n    TableName : TEXT\n    Record : INTEGER\n    Description : TEXT\n    ActionDate : DATE\n}\n\n\nMembers ||--o{ Borrowing : \&quot;borrows\&quot;\n\nBooks ||--o{ Borrowing : \&quot;is borrowed\&quot;\n\nBorrowing ||--o| Fines : \&quot;generates\&quot;\n\nBooks ||--o{ Acquisitions : \&quot;acquired\&quot;\n\nBooks ||--o{ PriceHistory : \&quot;price history\&quot;\n\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="t6JOmnQ4w9CmnWXmzGEJ-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
